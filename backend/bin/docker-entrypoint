#!/bin/bash -e

# Enable jemalloc for reduced memory usage and latency.
if [ -z "${LD_PRELOAD+x}" ]; then
    LD_PRELOAD=$(find /usr/lib -name libjemalloc.so.2 -print -quit)
    export LD_PRELOAD
fi

# Fall back to a randomly generated SECRET_KEY_BASE if one isn't provided,
# so the image can still boot when run standalone (e.g. CI smoke checks
# that invoke `docker run`/`docker compose` without passing env vars). Real
# deployments (Render, see render.yaml) always inject their own
# SECRET_KEY_BASE, which takes precedence over this fallback.
if [ -z "${SECRET_KEY_BASE}" ]; then
    export SECRET_KEY_BASE=$(ruby -rsecurerandom -e "print SecureRandom.hex(64)")
fi

# If running the rails server then create or migrate existing database
if [ "${@: -2:1}" == "./bin/rails" ] && [ "${@: -1:1}" == "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
